/*
 Local secrets template.
 Copy this file to VibeSecrets.swift and fill in your API keys:

     cp Nyxian/UI/Vibe/VibeSecrets.swift.example Nyxian/UI/Vibe/VibeSecrets.swift

 VibeSecrets.swift is gitignored, so your keys never enter version history.
 Leave any key empty ("") to disable that provider.
*/

enum VibeSecrets {
    /// Primary OpenAI-compatible endpoint (Google Gemini).
    static let defaultServerURL = "https://generativelanguage.googleapis.com/v1beta/openai"
    static let defaultAPIKey = ""   // e.g. your Gemini API key
    static let defaultModel = "gemini-3.5-flash-lite"

    /// Ordered fallbacks used when the primary provider fails.
    static let fallbackProviders: [(name: String, url: String, key: String, model: String)] = [
        (name: "Groq", url: "https://api.groq.com/openai/v1", key: "", model: "openai/gpt-oss-120b"),
        (name: "NVIDIA NIM", url: "https://integrate.api.nvidia.com/v1", key: "", model: "moonshotai/kimi-k3")
    ]
}
